# API Configuration
API_KEY=your_api_key
API_URL=https://content.guardianapis.com
MAX_RECORDS=1000
BATCH_SIZE=100
MAX_RETRIES=3
FROM_DATE=2025-01-01  # Optional: set your desired start date

# Logging Configuration
LOG_LEVEL=INFO

POSTGRES_DB=your_postgre_db_name
POSTGRES_USER=your_postgre_db_user_name
POSTGRES_PASSWORD=your_secure_password
POSTGRES_PORT=5432

SNOWFLAKE_USER=your_username
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_PRIVATE_KEY_FILE_PATH=/path/to/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_FILE_PWD=your_passphrase
SNOWFLAKE_WAREHOUSE=your_warehouse_name
SNOWFLAKE_DATABASE=your_database_name
SNOWFLAKE_SCHEMA=your_schema_name
SNOWFLAKE_ROLE=your_role_name

# GCP / BigQuery (warehouse migration target)
# Auth: `gcloud auth application-default login` (Application Default Credentials).
# No service-account key file - org policy blocks key creation.
GCP_PROJECT=your_gcp_project_id
# dbt surrogate-key salt. Required (no default). Must equal the value the existing
# tables were hashed with - changing it re-keys rows. Cloud Run reads Secret Manager news-salt.
NEWS_SALT=your_news_salt
# The dbt profile lives in capstone_dbt_project/.dbt; a relative path resolves against the
# dbt project dir. Needed by the dbt Power User extension (the CLI passes --profiles-dir .dbt).
DBT_PROFILES_DIR=.dbt
BQ_LOCATION=asia-southeast1
BQ_DATASET_RAW=raw
BQ_RAW_TABLE=raw_data
GCS_LANDING_BUCKET=your_landing_bucket
GCS_RAWHTML_BUCKET=your_rawhtml_bucket
GCS_LANDING_PREFIX=guardian

# --- AI agent (ai_agents/core/config.py); all optional, defaults shown ---
# AGENT_MAX_BYTES_PER_QUERY=600000000   # BigQuery cap per agent query
# AGENT_DEFAULT_WINDOW_DAYS=90          # keyword search / browse window without dates
# AGENT_MAX_TOKENS=1500
# AGENT_REASONING_EFFORT=low        # gpt-5.x / o-series only
# AGENT_HISTORY_TURNS=6                 # user turns sent to the LLM
# AGENT_RATE_LIMIT_PER_HOUR=30          # questions per session per hour
# EMBEDDING_MODEL=text-embedding-3-small
# PINECONE_ARTICLES_NAMESPACE=guardian_articles
# PINECONE_USER_DOCS_NAMESPACE=user_documents
