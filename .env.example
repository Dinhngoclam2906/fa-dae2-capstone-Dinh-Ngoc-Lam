# API Configuration
API_KEY=your_api_key
API_URL=https://content.guardianapis.com
MAX_RECORDS=1000
BATCH_SIZE=100
MAX_RETRIES=3
FROM_DATE=2025-01-01  # Optional: set your desired start date

# Logging Configuration
LOG_LEVEL=INFO

POSTGRES_DB=your_postgre_db_name
POSTGRES_USER=your_postgre_db_user_name
POSTGRES_PASSWORD=your_secure_password
POSTGRES_PORT=5432

SNOWFLAKE_USER=your_username
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_PRIVATE_KEY_FILE_PATH=/path/to/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_FILE_PWD=your_passphrase
SNOWFLAKE_WAREHOUSE=your_warehouse_name
SNOWFLAKE_DATABASE=your_database_name
SNOWFLAKE_SCHEMA=your_schema_name
SNOWFLAKE_ROLE=your_role_name

# GCP / BigQuery (warehouse migration target)
# Auth: `gcloud auth application-default login` (Application Default Credentials).
# No service-account key file - org policy blocks key creation.
GCP_PROJECT=your_gcp_project_id
BQ_LOCATION=asia-southeast1
BQ_DATASET_RAW=raw
BQ_RAW_TABLE=raw_data
GCS_LANDING_BUCKET=your_landing_bucket
GCS_RAWHTML_BUCKET=your_rawhtml_bucket
GCS_LANDING_PREFIX=guardian