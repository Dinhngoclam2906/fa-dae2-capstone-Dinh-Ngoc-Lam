# API Configuration
API_KEY=
API_URL=https://content.guardianapis.com
MAX_RECORDS=1000
BATCH_SIZE=100
MAX_RETRIES=3
FROM_DATE=2025-01-01  # Optional: set your desired start date

# Logging Configuration
LOG_LEVEL=INFO

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=your_secure_password
POSTGRES_PORT=5432

SNOWFLAKE_USER=your_username
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_PRIVATE_KEY_FILE_PATH=/path/to/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_FILE_PWD=your_passphrase
SNOWFLAKE_WAREHOUSE=your_warehouse_name
SNOWFLAKE_DATABASE=your_database_name
SNOWFLAKE_SCHEMA=your_schema_name
SNOWFLAKE_ROLE=your_role_name