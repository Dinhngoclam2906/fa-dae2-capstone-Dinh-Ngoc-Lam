# Dockerfile.cost - image for the cost-report Cloud Run Job (daily cost email,
# scripts/monitoring/cost_report.py). Build from a minimal context: the repo root has
# no .gcloudignore.
FROM python:3.13-slim

WORKDIR /app

COPY scripts/monitoring/requirements-cost.txt ./
RUN pip install --no-cache-dir -r requirements-cost.txt

COPY scripts/monitoring/cost_report.py ./scripts/monitoring/

CMD ["python", "scripts/monitoring/cost_report.py", "--save", "--email"]
