# Dockerfile.embed - image for the embed-sync Cloud Run Job (ai_agents/run_embed_job.sh):
# gemini-embedding-2 article vectors -> BigQuery vectors.article_embeddings -> Pinecone.
# Minimal: the two pipeline scripts and the two core modules they import, not the agent.
# Build from a minimal context (like Dockerfile.ingestion): the repo root has no
# .gcloudignore.
FROM python:3.13-slim

WORKDIR /app

COPY ai_agents/requirements-embed.txt ./
RUN pip install --no-cache-dir -r requirements-embed.txt

COPY ai_agents/core/__init__.py ai_agents/core/config.py ai_agents/core/bq.py ./ai_agents/core/
COPY ai_agents/embed_articles.py ai_agents/sync_vector_index.py ai_agents/run_embed_job.sh ./ai_agents/

CMD ["sh", "ai_agents/run_embed_job.sh"]
