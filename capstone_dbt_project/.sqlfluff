[sqlfluff]
# Database dialect (Snowflake-specific for your project)
dialect = snowflake

# Templater for dbt projects
templater = dbt

# General settings (tuned for dbt/news data complexity)
runaway_limit = 10
max_line_length = 200
indent_unit = space

# Exclude specific rules (optimized for your SCD/incrementals: skips UPPER IDs, booleans, implicit aliases/joins, CASE, select lines)
exclude_rules = RF02, AM06, L034, ST02, ST06, CP04, AL01, AL03, AM05, CP02, LT09

# Indentation settings (2 spaces for compact dbt models)
[sqlfluff:indentation]
tab_space_size = 2

# Layout and formatting (trailing commas for easy dbt ref adds)
[sqlfluff:layout:type:comma]
spacing_before = touch
line_position = trailing

# Capitalization rules (MIXED: Upper keywords for structure; lower for readability)
[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower

# Aliasing rules (explicit for clarity in your joins/dims; excluded implicit for SCD)
[sqlfluff:rules:aliasing.table]
aliasing = explicit

[sqlfluff:rules:aliasing.column]
aliasing = explicit

[sqlfluff:rules:aliasing.expression]
allow_scalar = False

# Column reference rules (implicit for your GROUP BY in summaries)
[sqlfluff:rules:ambiguous.column_references]
group_by_and_order_by_style = implicit

# dbt templater configuration (updated to your setup from Steps 3-4)
[sqlfluff:templater:dbt]
project_dir = .
profiles_dir = .dbt
profile = capstone_dbt_project
target = dev
dbt_skip_compilation_error = True
dbt_skip_connection_error = True

# Enable dbt builtins for Jinja templater (for {{ ref() }} in your models)
[sqlfluff:templater:jinja]
apply_dbt_builtins = True