with __dbt__cte__int_article_metrics as (


SELECT
    section_name,
    COUNT(*) AS article_count,
    ROUND(AVG(LENGTH(body_text)), 0) AS avg_body_length_chars,
    COUNT(DISTINCT web_url) AS unique_urls,
    MIN(crawl_timestamp) AS earliest_crawl,
    MAX(loaded_at) AS latest_load,
    SUM(CASE WHEN has_valid_content THEN 1 ELSE 0 END) AS valid_articles,
    CURRENT_TIMESTAMP() AS processed_at
FROM DB_T26.STAGING.stg_sf__guardian
GROUP BY section_name
HAVING article_count > 1
) SELECT
    section_name,
    article_count,
    avg_body_length_chars,
    unique_urls,
    earliest_crawl,
    latest_load,
    valid_articles,
    ROUND((valid_articles * 100.0 / article_count), 2) AS valid_rate_percent,
    processed_at
FROM __dbt__cte__int_article_metrics  # Depends on intermediate
ORDER BY article_count DESC
        )
        order by (
            section_name
        )
    )

