p%' \n             AND LENGTH(TRIM(web_url)) <= 1000  -- Reasonable URL length\n        THEN TRUE\n        ELSE FALSE\n    END AS has_valid_url,\n\n    CASE\n        WHEN body_text IS NOT NULL \n             AND TRIM(body_text) != '' \n             AND LENGTH(TRIM(body_text)) > 50  -- Basic content threshold\n        THEN TRUE\n        ELSE FALSE\n    END AS has_valid_content,\n\n    CASE\n        WHEN section_name IS NOT NULL AND TRIM(section_name) != ''\n        THEN TRUE\n        ELSE FALSE\n    END AS has_valid_section,\n\n    -- Processing metadata\n    CURRENT_TIMESTAMP() AS processed_at,\n    'dbt_staging' AS processing_source\n\nFROM raw_articles\nWHERE article_id IS NOT NULL  -- Ensure core identifier is present\n  AND has_valid_title  -- Filter out invalid titles early (optional; can be removed if tests handle it)", "relation_name": "DB_T26.STAGING_staging.stg_sf__guardian", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-10-11T04:27:01.381034Z", "completed_at": "2025-10-11T04:27:01.414707Z"}, {"name": "execute", "started_at": "2025-10-11T04:27:01.415449Z", "completed_at": "2025-10-11T04:27:01.415462Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.06026959419250488, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.capstone_dbt_project.source_not_null_raw_raw_data_article_id.540a11b677", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect article_id\nfrom DB_T26.sc_t26.raw_data\nwhere article_id is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-10-11T04:27:01.404583Z", "completed_at": "2025-10-11T04:27:01.436387Z"}, {"name": "execute", "started_at": "2025-10-11T04:27:01.437442Z", "completed_at": "2025-10-11T04:27:01.437460Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.07884883880615234, "adapter_response": {}, "message": null, "failures": null, "unique_id": "mod