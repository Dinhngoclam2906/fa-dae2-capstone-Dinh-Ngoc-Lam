    as (select * from (
            

SELECT
    ROW_NUMBER() OVER (ORDER BY article_id) as article_key,  -- Surrogate
    a.article_id,
    s.section_key,
    pd.pub_date_key,
    cd.crawl_date_key,
    ld.load_date_key,
    a.web_title,
    a.web_url,
    a.body_length_chars,  -- From staging (LENGTH(body_text))
    a.is_valid_title as valid_title_flag,  -- Boolean as 1/0 measure
    a.is_valid_url as valid_url_flag,
    a.is_valid_content as valid_content_flag,
    a.is_valid_section as valid_section_flag,
    -- Business metrics
    CASE WHEN a.is_valid_content THEN 1 ELSE 0 END as valid_article_count,  -- For sum
    DATEDIFF('day', pd.full_date, cd.full_date) as pub_to_crawl_delay_days,  -- Derived metric
    a.processed_at,
    CURRENT_TIMESTAMP() as dbt_updated_at
FROM DB_T26.STAGING.stg_sf__guardian a
JOIN DB_T26.STAGING.dim_sections s ON a.section_name = s.section_name AND s.is_current = TRUE
JOIN DB_T26.STAGING.dim_publication_dates pd ON DATE(a.web_publication_date) = pd.full_date
JOIN DB_T26.STAGING.dim_crawl_dates cd ON DATE(a.crawl_timestamp) = cd.full_date
JOIN DB_T26.STAGING.dim_load_dates ld ON DATE(a.loaded_at) = ld.full_date
WHERE a.article_id IS NOT NULL


        )
        order by (
            pub_date_key, section_key
        )
    )

