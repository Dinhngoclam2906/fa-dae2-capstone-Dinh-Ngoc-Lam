    as (select * from (
            

WITH section_changes AS (
    SELECT
        section_name,  -- Natural key
        MAX(COALESCE(section_name, '')) as section_description,  -- Placeholder; use real desc if in data
        MIN(crawl_timestamp) as created_at,  -- Earliest article in section
        -- Hash for change detection (simple for static-ish sections)
        MD5(CONCAT(COALESCE(section_name, ''), COALESCE(MAX(COALESCE(section_name, '')), ''))) as change_hash
    FROM DB_T26.STAGING.stg_sf__guardian
    WHERE section_name IS NOT NULL
    GROUP BY section_name
),
-- Handle first run: Empty if table doesn't exist yet
existing_sections AS (
    SELECT 
        section_name,
        change_hash as existing_hash,
        valid_from,
        valid_to,
        is_current
    FROM DB_T26.STAGING.dim_sections  -- Will be empty on first run
    WHERE is_current = TRUE
    QUALIFY ROW_NUMBER() OVER (PARTITION BY section_name ORDER BY valid_from DESC) = 1  -- Latest per section
),
change_detection AS (
    SELECT
        s.*,
        e.existing_hash,
        e.valid_from,
        e.valid_to,
        e.is_current,
        CASE
            WHEN e.existing_hash IS NULL THEN 'new'
            WHEN s.change_hash != e.existing_hash THEN 'changed'
            ELSE 'unchanged'
        END as change_type
    FROM section_changes s
    LEFT JOIN existing_sections e ON s.section_name = e.section_name
),
-- Expire old on changes (only if existing)
expired_records AS (
    SELECT 
        ROW_NUMBER() OVER (ORDER BY cd.created_at) as section_key,
        cd.section_name,
        cd.section_description,
        cd.created_at,
        cd.existing_hash as change_hash,
        cd.valid_from,
        CURRENT_TIMESTAMP() as valid_to,
        FALSE as is_current,
        'expired' as change_type
    FROM change_detection cd
    WHERE cd.change_type = 'changed'
),
-- New/changed/unchanged
active_records AS (
    SELECT
        ROW_NUMBER() OVER (PARTITION BY section_name ORDER BY created_at) as section_key,
        section_name,
        section_description,
        CASE
            WHEN change_type IN ('new', 'changed') THEN created_at
            ELSE COALESCE(valid_from, created_at)
        END as valid_from,
        CASE
            WHEN change_type = 'changed' THEN CURRENT_TIMESTAMP()
            WHEN change_type IN ('new', 'unchanged') THEN '9999-12-31'::DATE
            ELSE COALESCE(valid_to, '9999-12-31'::DATE)
        END as valid_to,
        CASE
            WHEN change_type = 'changed' THEN FALSE
            ELSE COALESCE(is_current, TRUE)
        END as is_current,
        change_type,
        created_at
    FROM change_detection
    WHERE change_type != 'expired'  -- Exclude for active
)
SELECT 
    *,
    CURRENT_TIMESTAMP() as dbt_updated_at
FROM active_records
UNION ALL
SELECT 
    section_key,
    section_name,
    section_description,
    created_at,
    change_hash,
    valid_from,
    valid_to,
    is_current,
    change_type,
    CURRENT_TIMESTAMP() as dbt_updated_at
FROM expired_records
ORDER BY section_name, valid_from
        )
        order by (
            section_name
        )
    )

