  as (
    

WITH base_articles AS (
    SELECT
        article_id,
        web_title,
        body_text,
        web_url,
        section_name,
        crawl_timestamp,
        -- Detect changes using hash (focus on content fields)
        MD5(
            CONCAT(
                COALESCE(web_title, ''),
                COALESCE(body_text, ''),
                COALESCE(section_name, ''),
                COALESCE(web_url, '')
            )
        ) as change_hash,
        -- Surrogate for incremental unique (article_id + crawl_timestamp for versions)
        MD5(CONCAT(article_id, crawl_timestamp)) as article_version_key
    FROM DB_T26.STAGING.stg_sf__guardian
    WHERE article_id IS NOT NULL
      AND has_valid_content = TRUE  -- From your staging
),


existing_articles AS (
    SELECT
        article_id,
        change_hash as existing_hash,
        article_version_key,
        valid_from,
        valid_to,
        is_current
    FROM DB_T26.STAGING.dim_articles
    WHERE is_current = TRUE
),
change_detection AS (
    SELECT
        b.*,
        e.existing_hash,
        e.article_version_key as existing_version_key,
        CASE
            WHEN e.existing_hash IS NULL THEN 'new'
            WHEN b.change_hash != e.existing_hash THEN 'changed'
            ELSE 'unchanged'
        END as change_type
    FROM base_articles b
    LEFT JOIN existing_articles e ON b.article_id = e.article_id
),


scd_records AS (
    
    SELECT
        article_id,
        web_title,
        body_text,
        web_url,
        section_name,
        article_version_key,
        -- SCD Type 2 logic (use crawl_timestamp as baseline)
        CASE
            WHEN change_type = 'new' THEN crawl_timestamp
            WHEN change_type = 'changed' THEN CURRENT_TIMESTAMP()
            ELSE valid_from
        END as valid_from,
        CASE
            WHEN change_type = 'changed' THEN CURRENT_TIMESTAMP()
            ELSE '9999-12-31'::TIMESTAMP_NTZ  -- Open-ended future
        END as valid_to,
        CASE
            WHEN change_type = 'changed' THEN FALSE
            ELSE TRUE
        END as is_current,
        change_type,
        crawl_timestamp
    FROM change_detection
    WHERE change_type IN ('new', 'changed')  -- Only insert/update rows
    
)

SELECT
    *,
    CURRENT_TIMESTAMP() as dbt_updated_at
FROM scd_records


    -- Incremental filter: Only new/changed versions
    WHERE change_type IN ('new', 'changed')

  )
