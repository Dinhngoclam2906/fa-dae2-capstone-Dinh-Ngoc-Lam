    as (select * from (
            

WITH section_changes AS (
    SELECT
        section_name,  -- Natural key
        section_description,
        created_at,  -- From staging if available; else now()
        -- Detect changes using hash (adapt to section metadata)
        MD5(
            CONCAT(
                COALESCE(section_name, ''),
                COALESCE(section_description, '')
            )
        ) as change_hash
    FROM DB_T26.STAGING.stg_sf__guardian  -- Pull unique sections from staging
    GROUP BY section_name, section_description, created_at  -- Dedupe
    WHERE section_name IS NOT NULL
),
existing_sections AS (
    SELECT
        section_name,
        change_hash as existing_hash,
        valid_from,
        valid_to,
        is_current
    FROM DB_T26.STAGING.dim_sections
    WHERE is_current = TRUE
),
change_detection AS (
    SELECT
        s.*,
        e.existing_hash,
        CASE
            WHEN e.existing_hash IS NULL THEN 'new'
            WHEN s.change_hash != e.existing_hash THEN 'changed'
            ELSE 'unchanged'
        END as change_type
    FROM section_changes s
    LEFT JOIN existing_sections e USING (section_name)
),
scd_records AS (
    SELECT
        ROW_NUMBER() OVER (PARTITION BY section_name ORDER BY created_at) as section_key,  -- Surrogate key
        section_name,
        section_description,
        -- SCD Type 2 logic
        CASE
            WHEN change_type = 'new' THEN created_at
            WHEN change_type = 'changed' THEN CURRENT_TIMESTAMP()
            ELSE valid_from
        END as valid_from,
        CASE
            WHEN change_type = 'changed' THEN CURRENT_TIMESTAMP()
            ELSE '9999-12-31'::DATE  -- Open-ended for unchanged
        END as valid_to,
        CASE
            WHEN change_type = 'changed' THEN FALSE
            ELSE TRUE
        END as is_current,
        change_type
    FROM change_detection
    WHERE change_type IN ('new', 'changed')
)
SELECT
    *,
    CURRENT_TIMESTAMP() as dbt_updated_at
FROM scd_records
        )
        order by (
            section_name
        )
    )

