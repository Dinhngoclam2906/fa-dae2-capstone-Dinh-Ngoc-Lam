    -- Enhanced data quality flags
    CASE
        WHEN web_title IS NOT NULL 
             AND TRIM(UPPER(web_title)) != '' 
             AND LENGTH(TRIM(web_title)) <= 500  -- Reasonable title length cap
        THEN TRUE
        ELSE FALSE
