[0m00:12:15.183243 [info ] [MainThread]: Compiled node 'news_freshness' is:
-- Monitoring model for news freshness (run with: dbt run --select tag:monitoring)


WITH latest_runs AS (
    SELECT
        MAX(web_publication_date) AS latest_pub_date,
        MAX(dbt_updated_at) AS last_dbt_run,  -- From your fact metadata
        COUNT(DISTINCT article_id) AS recent_articles,
        CURRENT_TIMESTAMP() AS check_timestamp
    FROM DB_T26.STAGING.fct_advanced_articles f  -- Self-contained: No external source
    WHERE web_publication_date >= DATEADD('day', -7, CURRENT_DATE())  -- Last week for recency
)
SELECT
    latest_pub_date,
    last_dbt_run,
    DATEDIFF('hour', latest_pub_date, check_timestamp) AS freshness_hours,  -- Key metric: Hours since last article
    recent_articles,
    CASE 
        WHEN DATEDIFF('hour', latest_pub_date, check_timestamp) <= 24 THEN 'Fresh' 
        WHEN DATEDIFF('hour', latest_pub_date, check_timestamp) <= 72 THEN 'Moderate' 
        ELSE 'Stale - Alert!' 
    END AS freshness_status,  -- News KPI: <24h = timely crawls
    check_timestamp
FROM latest_runs
ORDER BY check_timestamp DESC
LIMIT 1  -- Latest check only
