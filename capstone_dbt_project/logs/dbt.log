WITH base AS (
    SELECT 
        -- Explicit selects: Only what's needed for score + grouping (no * to avoid extras like LOADED_AT)
        f.SECTION_KEY,
        f.BODY_LENGTH_CHARS,
        f.TITLE_TO_BODY_RATIO,
        f.VALID_CONTENT_FLAG,
        -- Use custom macro for engagement score
        
    -- RFM-like for news: Length * ratio * validity (body_len already numeric; no cast needed)
    GREATEST(0, (f.BODY_LENGTH_CHARS * f.TITLE_TO_BODY_RATIO * f.VALID_CONTENT_FLAG)) / 1000.0
 AS ENGAGEMENT_SCORE
    FROM DB_T26.STAGING.fct_advanced_articles f
),
-- Aggregate for section_group
section_metrics AS (
    SELECT
        s.SECTION_GROUP,
        SUM(ENGAGEMENT_SCORE) AS TOTAL_ENGAGEMENT_SCORE,
        AVG(ENGAGEMENT_SCORE) AS AVG_ENGAGEMENT_SCORE
    FROM base b
    JOIN DB_T26.STAGING.dim_sections s ON b.SECTION_KEY = s.SECTION_KEY
    GROUP BY s.SECTION_GROUP
)
SELECT * FROM section_metrics  -- Safe * here (small CTE, known columns)
