    as (select * from (
            

WITH section_changes AS (
    SELECT
        section_name,
        section_name as section_description,  -- Placeholder
        MIN(crawl_timestamp) as created_at,
        MD5(section_name) as change_hash  -- Simple for static
    FROM DB_T26.STAGING.stg_sf__guardian
    WHERE section_name IS NOT NULL
    GROUP BY section_name
),
existing_sections AS (
    
    SELECT NULL as section_name, NULL as existing_hash, NULL as valid_from, NULL as valid_to, NULL as is_current
    
),
change_detection AS (
    SELECT
        s.*,
        e.existing_hash,
        e.valid_from,
        e.valid_to,
        e.is_current,
        CASE
            WHEN e.existing_hash IS NULL THEN 'new'
            WHEN s.change_hash != e.existing_hash THEN 'changed'
            ELSE 'unchanged'
        END as change_type
    FROM section_changes s
    LEFT JOIN existing_sections e ON s.section_name = e.section_name
),
expired_records AS (
    SELECT 
        section_name,
        section_description,
        created_at,
        existing_hash as change_hash,
        valid_from,
        CURRENT_TIMESTAMP() as valid_to,
        FALSE as is_current,
        'expired' as change_type
    FROM change_detection
    WHERE change_type = 'changed'
),
active_records AS (
    SELECT
        ROW_NUMBER() OVER (PARTITION BY section_name ORDER BY created_at) as section_key,
        section_name,
        section_description,
        CASE WHEN change_type IN ('new', 'changed') THEN created_at ELSE valid_from END as valid_from,
        CASE WHEN change_type = 'changed' THEN CURRENT_TIMESTAMP() ELSE '9999-12-31'::DATE END as valid_to,
        CASE WHEN change_type = 'changed' THEN FALSE ELSE TRUE END as is_current,
        change_type
    FROM change_detection
    WHERE change_type IN ('new', 'changed', 'unchanged')
)
SELECT *, CURRENT_TIMESTAMP() as dbt_updated_at FROM active_records

UNION ALL
SELECT section_key, *, 'expired' as change_type, CURRENT_TIMESTAMP() as dbt_updated_at FROM expired_records
ORDER BY section_name, valid_from
        )
        order by (
            section_name
        )
    )

