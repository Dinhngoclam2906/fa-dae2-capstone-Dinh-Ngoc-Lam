    as (select * from (
            

WITH section_changes AS (
    SELECT
        section_name,  -- Natural key
        MAX(COALESCE(section_description, '')) as section_description,  -- Assume static; MAX for dedupe
        CURRENT_TIMESTAMP() as created_at,  -- Fallback; could use MIN(crawl_timestamp) if needed
        -- Detect changes using hash (adapt to section metadata)
        MD5(
            CONCAT(
                COALESCE(section_name, ''),
                COALESCE(MAX(COALESCE(section_description, '')), '')
            )
        ) as change_hash
    FROM DB_T26.STAGING.stg_sf__guardian
    WHERE section_name IS NOT NULL
    GROUP BY section_name  -- Dedupe sections
),
existing_sections AS (
    SELECT
        section_name,
        change_hash as existing_hash,
        valid_from,
        valid_to,
        is_current
    FROM DB_T26.STAGING.dim_sections
    WHERE is_current = TRUE
),
change_detection AS (
    SELECT
        s.*,
        e.existing_hash,
        e.valid_from,
        e.valid_to,
        e.is_current,
        CASE
            WHEN e.existing_hash IS NULL THEN 'new'
            WHEN s.change_hash != e.existing_hash THEN 'changed'
            ELSE 'unchanged'
        END as change_type
    FROM section_changes s
    LEFT JOIN existing_sections e USING (section_name)
),
-- Expire old records on changes
expired_records AS (
    SELECT 
        section_name,
        section_description,
        created_at,
        existing_hash as change_hash,
        valid_from,
        CURRENT_TIMESTAMP() as valid_to,
        FALSE as is_current,
        'expired' as change_type
    FROM change_detection
    WHERE change_type = 'changed'
),
-- New/changed records
new_changed_records AS (
    SELECT
        ROW_NUMBER() OVER (PARTITION BY section_name ORDER BY created_at) as section_key,  -- Surrogate
        section_name,
        section_description,
        CASE
            WHEN change_type = 'new' THEN created_at
            WHEN change_type = 'changed' THEN CURRENT_TIMESTAMP()
            ELSE valid_from
        END as valid_from,
        CASE
            WHEN change_type IN ('new', 'unchanged') THEN '9999-12-31'::DATE
            ELSE valid_to
        END as valid_to,  -- Propagate for unchanged
        CASE
            WHEN change_type = 'changed' THEN TRUE
            ELSE e.is_current  -- Propagate
        END as is_current,
        change_type
    FROM change_detection
    WHERE change_type IN ('new', 'changed', 'unchanged')
)
SELECT *, CURRENT_TIMESTAMP() as dbt_updated_at FROM new_changed_records
UNION ALL
SELECT section_key, *, change_type, CURRENT_TIMESTAMP() as dbt_updated_at FROM expired_records
        )
        order by (
            section_name
        )
    )

