        END as is_today,
        -- News-specific: Holidays? (Simple flag; expand with holiday table if needed)
        FALSE as is_holiday  -- Placeholder; integrate external holiday data if relevant
    FROM date_spine
    WHERE date_value <= CURRENT_DATE()
)
