  as (
    -- Config: Incremental with multi-hash key for news events (handles re-crawls)
-- Cluster by date/section for query perf


WITH article_events AS (
    SELECT
        article_id,
        crawl_timestamp,
        web_publication_date,
        section_name,
        -- Advanced multi-hash: Composite for news events
        md5(cast(coalesce(cast(article_id as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(crawl_timestamp as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(section_name as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS article_event_hk
    FROM DB_T26.STAGING.stg_sf__guardian
    WHERE web_publication_date >= '2010-01-01'
      AND has_valid_title = TRUE
),

base_facts AS (
    SELECT
        ae.article_id,
        ae.crawl_timestamp,
        ae.web_publication_date,
        ae.article_event_hk,
        -- Dims
        d.date_id,
        s.section_key,
        art.article_id AS article_dim_key,
        art.is_current,
        -- Metrics
        LENGTH(a.body_text) AS body_length_chars,
        CASE WHEN a.has_valid_content THEN 1 ELSE 0 END AS valid_content_flag,
        LENGTH(a.body_text) / NULLIF(LENGTH(a.web_title), 0) AS title_to_body_ratio,
        a.web_url
    FROM article_events ae
    JOIN DB_T26.STAGING.stg_sf__guardian a ON ae.article_id = a.article_id AND ae.crawl_timestamp = a.crawl_timestamp
    JOIN DB_T26.STAGING.dim_date_cross_db d ON DATE(ae.web_publication_date) = d.date_value  -- Portable dim
    JOIN DB_T26.STAGING.dim_sections s ON ae.section_name = s.section_name
    JOIN DB_T26.STAGING.dim_articles_advanced_scd art ON ae.article_id = art.article_id AND art.is_current = TRUE  -- Advanced SCD
    WHERE ae.web_publication_date IS NOT NULL
)

SELECT *, CURRENT_TIMESTAMP() AS dbt_updated_at FROM base_facts  -- Added: Metadata for monitoring/freshness


