-- models/03_mart/mart_engagement.sql (fixed: removed unnecessary TRY_TO_NUMBER; integrated custom macro)


WITH base AS (
    SELECT 
        *, 
        -- Use custom macro for engagement score (reusable, cross-db friendly)
        
    -- RFM-like for news: Length * ratio * validity
    GREATEST(0, (
    
        CAST(body_length_chars AS NUMERIC)
    
 * title_to_body_ratio * valid_content_flag)) / 1000
 AS engagement_score
    FROM DB_T26.STAGING.fct_advanced_articles
),
-- Inline dynamic metrics: Generate aggs for section_group
section_metrics AS (
    SELECT
        s.section_group,
        SUM(engagement_score) AS total_engagement_score,
        AVG(engagement_score) AS avg_engagement_score
    FROM base b
    JOIN DB_T26.STAGING.dim_sections s ON b.section_key = s.section_key
    GROUP BY s.section_group
)
SELECT * FROM section_metrics
