    as (select * from (
            

WITH section_changes AS (
    SELECT
        section_name,
        MAX(section_name) as section_description,  -- Placeholder (update if real desc added)
        MIN(crawl_timestamp) as created_at,
        MD5(CONCAT(COALESCE(section_name, ''), COALESCE(MAX(section_name), ''))) as change_hash
    FROM DB_T26.STAGING.stg_sf__guardian
    WHERE section_name IS NOT NULL
    GROUP BY section_name
),

existing_sections AS (
    SELECT * FROM (VALUES (NULL, NULL, NULL, NULL, NULL)) AS t(section_name, existing_hash, valid_from, valid_to, is_current)  -- Empty on first run
),

change_detection AS (
    SELECT
        s.*,
        e.existing_hash,
        e.valid_from,
        e.valid_to,
        e.is_current,
        CASE
            WHEN e.existing_hash IS NULL THEN 'new'
            WHEN s.change_hash != e.existing_hash THEN 'changed'
            ELSE 'unchanged'
        END as change_type
    FROM section_changes s
    LEFT JOIN existing_sections e ON s.section_name = e.section_name
),
expired_records AS (
    SELECT 
        ROW_NUMBER() OVER (ORDER BY cd.created_at) as section_key,
        cd.section_name,
        cd.section_description,
        cd.created_at,
        cd.existing_hash as change_hash,
        cd.valid_from,
        CURRENT_TIMESTAMP() as valid_to,
        FALSE as is_current,
        'expired' as change_type
    FROM change_detection cd
    WHERE cd.change_type = 'changed'
),
active_records AS (
    SELECT
        ROW_NUMBER() OVER (PARTITION BY section_name ORDER BY COALESCE(valid_from, created_at)) as section_key,
        section_name,
        section_description,
        CASE
            WHEN change_type IN ('new', 'changed') THEN created_at
            ELSE COALESCE(valid_from, created_at)
        END as valid_from,
        CASE
            WHEN change_type = 'changed' THEN CURRENT_TIMESTAMP()
            ELSE COALESCE(valid_to, '9999-12-31'::DATE)
        END as valid_to,
        CASE
            WHEN change_type = 'changed' THEN FALSE
            ELSE COALESCE(is_current, TRUE)
        END as is_current,
        change_type,
        created_at
    FROM change_detection
    WHERE change_type != 'expired'
    AND change_type != 'unchanged' OR is_incremental() = FALSE  -- Include unchanged on first
),
all_records AS (
    SELECT * FROM active_records
    UNION ALL
    SELECT * FROM expired_records
)
SELECT 
    *,
    CURRENT_TIMESTAMP() as dbt_updated_at
FROM all_records
ORDER BY section_name, valid_from
        )
        order by (
            section_name
        )
    )

