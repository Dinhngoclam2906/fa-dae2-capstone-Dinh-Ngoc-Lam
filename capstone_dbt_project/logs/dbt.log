[0m12:25:53.858820 [info ] [MainThread]: Compiled node 'mart_engagement' is:


WITH base AS (
    SELECT 
        *, 
        -- Inline news engagement score: RFM-like (length * ratio * validity / 1000, safe for Snowflake)
        GREATEST(0, (TRY_TO_NUMBER(body_length_chars) * title_to_body_ratio * valid_content_flag)) / 1000 AS engagement_score
    FROM DB_T26.STAGING.fct_advanced_articles
),
-- Inline dynamic metrics: Generate aggs for section_group
section_metrics AS (
    SELECT
        s.section_group,
        SUM(engagement_score) AS total_engagement_score,
        AVG(engagement_score) AS avg_engagement_score
    FROM base b
    JOIN DB_T26.STAGING.dim_sections s ON b.section_key = s.section_key
    GROUP BY s.section_group
)
SELECT * FROM section_metrics
