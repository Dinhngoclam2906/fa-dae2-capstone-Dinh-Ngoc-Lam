    COALESCE(LOADED_AT, CURRENT_TIMESTAMP()) AS LOADED_AT,  -- Fallback for any nulls (optional safety)

    -- Enhanced data quality flags (uppercase for consistency)
    CASE
        WHEN WEB_TITLE IS NOT NULL 
             AND TRIM(UPPER(WEB_TITLE)) != '' 
