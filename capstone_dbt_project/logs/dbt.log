            WHEN MONTH(date_value) IN (4,5,6) THEN 'Q2'
            WHEN MONTH(date_value) IN (7,8,9) THEN 'Q3'
            ELSE 'Q4'
        END AS fiscal_quarter,
        CASE WHEN DAYOFWEEK(date_value) IN (1,7) THEN TRUE ELSE FALSE END AS is_weekend,
        CASE WHEN date_value = CURRENT_DATE() THEN TRUE ELSE FALSE END AS is_today,
        FALSE AS is_holiday  -- Placeholder; add holiday table later if relevant for news analysis
    FROM date_spine
)
