    AVG(f.title_to_body_ratio) AS avg_engagement_proxy,
    CURRENT_TIMESTAMP() AS dbt_updated_at
FROM DB_T26.STAGING.fct_advanced_articles f
JOIN DB_T26.STAGING.dim_date_cross_db d ON f.date_id = d.date_id  -- Uses new portable dim
JOIN DB_T26.STAGING.dim_sections s ON f.section_key = s.section_key
GROUP BY 1, 2
        )
