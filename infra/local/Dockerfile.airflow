# Dockerfile.airflow  ← FINAL, SIMPLE, INSTRUCTOR-APPROVED VERSION
FROM apache/airflow:3.1.3-python3.12   

# Everything below runs as the correct 'airflow' user automatically
COPY requirements.txt ./

RUN pip install --no-cache-dir -r requirements.txt

# Make sure dbt, uv (if you used it locally), etc. are in PATH
ENV PATH="/home/airflow/.local/bin:${PATH}"

# Optional: copy your private key for Snowflake (if using key-pair auth)
RUN mkdir -p /opt/airflow/.secret && chmod 700 /opt/airflow/.secret
COPY --chown=airflow:0 --chmod=400 rsa_key.p8 /opt/airflow/.secret/rsa_key.p8